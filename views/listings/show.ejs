<% layout("/layouts/boilerplate.ejs") %>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h1>
                <%= listing.title %>
            </h1>
        </div>
        <div class="card col-6 offset-3 show-card mt-2">
            <img src="<%= listing. image.url %>" class="card-img-top show-img" alt="listing_image">
            <div class="card-body">
                <p class="card-text">
                    <b>
                    </b>
                    <%= listing.description %> <br>
                        &#8377; <%= listing.price.toLocaleString("en-IN") %> <br>
                            <%= listing.location %> <br>
                                <%= listing.country %>
                </p>
            </div>
        </div>

        <div class="offset-3 for-btn">
            <a href="/listings/<%=listing._id %>/edit" class="btn btn-dark edit-btn col-1">Edit</a>
            <br>
            <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE" class="col-1">
                <button class="btn btn-dark offset-4 col-12 ">delete</button>
            </form>
        </div>
        <br />
        <hr />
        <div class=" col-6 offset-3  mt-2 mb-2">
            <br>
            <h3>Leave a comments</h3>
            <form method="post" action="/listings/<%= listing._id %>/reviews"  novalidate class="needs-validation">
                <div>
                    <label class="form-label" for="rating ">Rating</label>
                    <input id="rating" min="1" max="5" class="form-range" type="range" name="review[rating]">
                </div>
                <div>
                    <label class="form-label" for="comments">Comment</label>
                    <textarea cols="30" 
                              rows="7"
                              id="comments" 
                              class="form-control" 
                              required 
                              name="review[comment]">
                             </textarea>
                </div>
                <br>
                <button class="btn btn-outline-dark">SUBMIT</button>

            </form>
        </div>
    </div>